# ==============================================================================
# ai-backend Production Environment Variables Template
# ==============================================================================
# Copy the keys below into your Vercel Project Settings:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
#
# IMPORTANT SECURITY RULES:
# - NEVER commit real production values or .env.production to Git.
# - NEVER share API keys or the DRIVE_ENCRYPTION_KEY with frontend clients.
# - All keys configured here remain strictly server-side inside Vercel Functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Topology
# ------------------------------------------------------------------------------
# In container environments, bind to 0.0.0.0
HOST=0.0.0.0
# Port assigned dynamically by Vercel; fallback to 8080
PORT=8080
# Runtime environment ('production' enforces strict authentication and validation)
APP_ENV=production
# Deployment mode: 'daemon' for container runtimes, 'serverless' for microVM adapters
DEPLOYMENT_MODE=daemon
# Structured JSON logging for production observability (e.g. Datadog, Vercel Logs)
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 2. Network & Reverse Proxy Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTP Host header values (prevent Host-header poisoning)
ALLOWED_HOSTS=your-project.vercel.app,api.yourdomain.com
# Trusted proxy IP/CIDR addresses (Vercel edge proxy loopback)
TRUSTED_PROXIES=127.0.0.1,::1
# Request body limit in bytes (4.5 MB aligns with Vercel serverless request limits)
MAX_BODY_SIZE_BYTES=4500000

# ------------------------------------------------------------------------------
# 3. Client Authentication & Access Control
# ------------------------------------------------------------------------------
# Server backend API key for authenticated API consumers (min 32 chars)
API_KEY=your_production_backend_api_key_here
# Optional comma-separated list of additional developer/IDE API keys
# API_KEYS=dev_key_one_min_32_chars,dev_key_two_min_32_chars
# Google OAuth 2.0 Client ID for validating Google Sign-In identity tokens (Audience check)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Optional comma-separated list of multiple client IDs (e.g. Android + Web)
# GOOGLE_CLIENT_IDS=android_client_id.apps.googleusercontent.com,web_client_id.apps.googleusercontent.com
# Mandatory authentication enforcement in production
AUTH_REQUIRED=true

# ------------------------------------------------------------------------------
# 4. Google Drive Encrypted Sync & Persistence
# ------------------------------------------------------------------------------
# Enable client-side Google Drive conversation and state synchronization
GOOGLE_DRIVE_SYNC_ENABLED=true
# 256-bit AES-GCM master encryption key (must be exactly 64 hexadecimal characters)
# Generate with: openssl rand -hex 32
DRIVE_ENCRYPTION_KEY=your_64_hex_char_master_key_here
# Remote application data folder name in Google Drive
GOOGLE_DRIVE_FOLDER_NAME=ai_backend_app_data
# Timeout for upstream Google Drive API calls in seconds
GOOGLE_DRIVE_TIMEOUT_SECS=30
# Maximum retries for transient Google Drive failures
GOOGLE_DRIVE_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Upstream AI Providers (Zero Client Secrets - Server Only)
# ------------------------------------------------------------------------------
# Groq Cloud API Key for ultra-fast chat completions (<2s latency)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional Groq default model override
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter API Key for unified multi-provider routing and reasoning
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Upstream timeout ceiling in seconds (must be within Vercel execution limits)
UPSTREAM_TIMEOUT_SECS=10

# ------------------------------------------------------------------------------
# 6. Abuse Prevention, Rate Limiting & SSRF Protection
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Unauthenticated IP burst limit (per 60-second window)
RATE_LIMIT_IP_BURST=100
# Unauthenticated IP sustained refill rate (req/s)
RATE_LIMIT_IP_RATE=20.0
# Authenticated principal burst limit
RATE_LIMIT_PRINCIPAL_BURST=200
# Authenticated principal sustained refill rate (req/s)
RATE_LIMIT_PRINCIPAL_RATE=50.0
# Chat inference burst limit per principal
RATE_LIMIT_CHAT_BURST=60
# Chat inference sustained refill rate (req/s)
RATE_LIMIT_CHAT_RATE=15.0
# Global in-flight HTTP request limit
MAX_CONCURRENT_REQUESTS=200
# Global concurrent streaming connections
MAX_CONCURRENT_STREAMS=50
# Strict SSRF outbound IP filtering (blocks RFC 1918, loopback, cloud metadata IPs)
SSRF_PROTECTION_ENABLED=true
